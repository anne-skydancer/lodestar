+void LLFloaterModelPreview::DecompRequest::assignAnalyzeData(const LLModel& model)
+{
+    for (S32 face_index = 0; face_index < model.getNumVolumeFaces(); ++face_index)
+    {
+        const LLVolumeFace& face = model.getVolumeFace(face_index);
+        if (face.mNumVertices < 0 || face.mNumIndices < 0 || face.mNumIndices % 3 != 0 ||
+            (face.mNumVertices > 0 && !face.mPositions) || (face.mNumIndices > 0 && !face.mIndices))
+        {
+            setStatusMessage("Lodestar: Invalid physics face.");
+            return;
+        }
+
+        const size_t offset = mPositions.size();
+        if (offset + static_cast<size_t>(face.mNumVertices) > U16_MAX)
+        {
+            setStatusMessage("Lodestar: A physics model exceeds the 65,535 vertex analysis limit.");
+            return;
+        }
+
+        for (S32 vertex = 0; vertex < face.mNumVertices; ++vertex)
+        {
+            const LLVector3 position(face.mPositions[vertex].getF32ptr());
+            if (!position.isFinite())
+            {
+                setStatusMessage("Lodestar: A physics model contains a non-finite position.");
+                return;
+            }
+            mPositions.push_back(position);
+        }
+
+        for (S32 index = 0; index < face.mNumIndices; ++index)
+        {
+            const U16 vertex = face.mIndices[index];
+            if (vertex >= face.mNumVertices)
+            {
+                setStatusMessage("Lodestar: A physics triangle has an out-of-range index.");
+                return;
+            }
+            mIndices.push_back(static_cast<U16>(offset + vertex));
+        }
+    }
+
+    if (mPositions.size() < 4 || mIndices.size() < 12)
+    {
+        setStatusMessage("Lodestar: A physics model needs at least four vertices and four triangles.");
+    }
 }
 
