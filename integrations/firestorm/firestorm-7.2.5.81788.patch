+void LLFloaterModelPreview::reportPhysicsAnalysisFailure(const std::string& message)
+{
+    const std::string result = message + (mLodestarStage == 3 ?
+        "\nHull conversion is unavailable. Checking the refined triangle collider." :
+        "\nPhysics analysis failed. No replacement collider was applied.");
+    addStringToLog(result, true);
+    getChild<LLTextBox>("lodestar_analysis_summary")->setText(result);
+    if (mLodestarStage == 3) return;
+    LLSD args;
+    args["MESSAGE"] = result;
+    LLNotificationsUtil::add("GenericAlert", args);
+}
+
+void LLFloaterModelPreview::startPhysicsAnalysis()
+{
+    if (!mModelPreview || mModelPreview->mLoading)
+    {
+        return;
+    }
+    if (mPhysicsFeePending)
+    {
+        reportPhysicsAnalysisFailure("Lodestar: Wait for the current fee calculation to finish before analyzing physics.");
+        return;
+    }
+
+    const auto& models = mModelPreview->mModel[LLModel::LOD_PHYSICS];
+    if (models.empty())
+    {
+        reportPhysicsAnalysisFailure("Lodestar: Select a physics source to analyze.");
+        return;
+    }
+
+    std::set<LLModel*> seen;
+    std::set<LLModel*> required_hulls;
+    if (mLodestarStage == 3)
+    {
+        mModelPreview->rebuildUploadData();
+        for (const auto& instance : mModelPreview->mUploadData)
+        {
+            if (instance.mModel.isNull() || instance.mModel->mSubmodelID || instance.mLOD[LLModel::LOD_PHYSICS].isNull()) continue;
+            const auto& matrix = instance.mTransform.mMatrix;
+            const F32 smallest = std::min({LLVector3(matrix[VX]).magVec(), LLVector3(matrix[VY]).magVec(), LLVector3(matrix[VZ]).magVec()});
+            if (smallest < .5f) required_hulls.insert(instance.mLOD[LLModel::LOD_PHYSICS].get());
+        }
+    }
+    std::vector<LLPointer<DecompRequest>> requests;
+    for (const auto& model : models)
+    {
+        if (model.isNull())
+        {
+            reportPhysicsAnalysisFailure("Lodestar: The physics source contains a missing model.");
+            return;
+        }
+        if (!seen.insert(model.get()).second)
+        {
+            continue;
+        }
+        if (!required_hulls.empty() && !required_hulls.contains(model.get())) continue;
+        LLPointer<DecompRequest> request = new DecompRequest("Analyze", model.get());
+        if (!request->mStatusMessage.empty())
+        {
+            reportPhysicsAnalysisFailure(request->mStatusMessage + " Model: " + model->getName());
+            return;
+        }
+        requests.push_back(request);
+    }
+
+    mAnalyzeSource = models;
+    mAnalyzeSourceLOD = mModelPreview->mPhysicsSearchLOD;
+    mAnalyzeRequests = std::move(requests);
+    getChild<LLTextBox>("lodestar_analysis_summary")->setText(std::string("Calculating a coherent collision shape from the selected source..."));
+    for (const auto& request : mAnalyzeRequests)
+    {
+        mCurRequest.insert(request);
+        gMeshRepo.mDecompThread->submitRequest(request.get());
+    }
+
+    childSetVisible("Analyze", false);
+    childSetVisible("analyze_cancel", true);
+    childEnable("analyze_cancel");
+    mCalculateBtn->setEnabled(false);
+    mUploadBtn->setEnabled(false);
+}
+
+void LLFloaterModelPreview::finishPhysicsAnalysis(DecompRequest* request)
+{
+    if (mCurRequest.erase(request) == 0 || !mCurRequest.empty())
+    {
+        return;
+    }
+
+    std::string error;
+    if (!mModelPreview || mModelPreview->mLoading ||
+        mAnalyzeSourceLOD != mModelPreview->mPhysicsSearchLOD ||
+        mAnalyzeSource != mModelPreview->mModel[LLModel::LOD_PHYSICS])
+    {
+        error = "Lodestar: The physics source changed during analysis.";
+    }
+
+    size_t hull_count = 0;
+    size_t vertex_count = 0;
+    size_t largest_hull = 0;
+    for (const auto& result : mAnalyzeRequests)
+    {
+        if (!error.empty())
+        {
+            break;
+        }
+        if (result->mHull.empty() || result->mHull.size() != result->mHullMesh.size())
+        {
+            if (result->mStatusMessage.compare(0, 10, "Lodestar: ") == 0)
+            {
+                error = result->mStatusMessage;
+            }
+            else
+            {
+                error = "Lodestar: Analysis did not produce a usable hull set.";
+            }
+            error += " Model: " + result->mModel->getName();
+            break;
+        }
+        hull_count += result->mHull.size();
+        for (const auto& hull : result->mHull)
+        {
+            vertex_count += hull.size();
+            largest_hull = std::max(largest_hull, hull.size());
+        }
+    }
+
+    if (error.empty())
+    {
+        mLodestarHullsSucceeded = mLodestarStage == 3;
+        for (auto& result : mAnalyzeRequests)
+        {
+            result->mModel->setConvexHullDecomposition(result->mHull, result->mHullMesh);
+            if (!result->mStatusMessage.empty())
+            {
+                addStringToLog(result->mModel->getName() + ": " + result->mStatusMessage, false);
+            }
+        }
+        mUploadModelUrl.clear();
+        mModelPreview->mDirty = true;
+        mModelPreview->refresh();
+        const auto summary = llformat("Lodestar: Generated %zu hulls across %zu physics models, "
+                               "%zu vertices total, largest hull %zu vertices (automatic).",
+                               hull_count, mAnalyzeRequests.size(), vertex_count, largest_hull);
+        addStringToLog(summary, false);
+        getChild<LLTextBox>("lodestar_analysis_summary")->setText(summary);
+    }
+    else
+    {
+        reportPhysicsAnalysisFailure(error);
+    }
+
+    cancelPhysicsAnalysis();
+    if (mModelPreview)
+    {
+        mModelPreview->updateStatusMessages();
+    }
+}
+
+void LLFloaterModelPreview::cancelPhysicsAnalysis()
+{
+    if (mAnalyzeRequests.empty())
+    {
+        return;
+    }
+
+    for (auto& request : mAnalyzeRequests)
+    {
+        request->mContinue = 0;
+        mCurRequest.erase(request);
+    }
+    mAnalyzeRequests.clear();
+    mAnalyzeSource.clear();
+    childSetVisible("Analyze", true);
+    childSetVisible("analyze_cancel", false);
+    mCalculateBtn->setEnabled(true);
+    mUploadBtn->setEnabled(isModelUploadAllowed());
+}
