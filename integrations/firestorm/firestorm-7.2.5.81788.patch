diff --git a/indra/newview/llfloatermodelpreview_lodestar.inc b/indra/newview/llfloatermodelpreview_lodestar.inc
new file mode 100644
index 0000000000..4e5222402b
--- /dev/null
+++ b/indra/newview/llfloatermodelpreview_lodestar.inc
@@ -0,0 +1,309 @@
+// Local preparation orchestration. Surface mathematics run in lodestar_c.dll
+// through the development worker. Native viewer import and hull conversion
+// remain on the viewer thread. This fragment is included after class headers.
+
+static bool lodestarContainerSurfaceValid(LLModel& model)
+{
+    LLVector3 minimum(F32_MAX,F32_MAX,F32_MAX), maximum(-F32_MAX,-F32_MAX,-F32_MAX);
+    for (const auto& face : model.getVolumeFaces())
+        for (S32 v = 0; v < face.mNumVertices; ++v)
+            update_min_max(minimum, maximum, face.mPositions[v].getF32ptr());
+    for (S32 axis = 0; axis < 3; ++axis)
+        if (!llfinite(minimum[axis]) || !llfinite(maximum[axis]) || minimum[axis] < -.501f || maximum[axis] > .501f) return false;
+    const LLVector3 range = maximum-minimum;
+    const auto decode = [&](const LLVector4a& point) {
+        LLVector3 result;
+        for (S32 axis = 0; axis < 3; ++axis)
+        {
+            const U16 value = range[axis] > 0.f ? (U16)(((point[axis]-minimum[axis])/range[axis])*65535.f) : 0;
+            result[axis] = (F32(value)/65535.f)*range[axis]+minimum[axis];
+        }
+        return result;
+    };
+    for (const auto& face : model.getVolumeFaces())
+    {
+        if (face.mNumIndices % 3) return false;
+        for (S32 i = 0; i < face.mNumIndices; i += 3)
+        {
+            for (S32 c = 0; c < 3; ++c) if (face.mIndices[i+c] >= face.mNumVertices) return false;
+            const auto a = decode(face.mPositions[face.mIndices[i]]);
+            const auto b = decode(face.mPositions[face.mIndices[i+1]]);
+            const auto c = decode(face.mPositions[face.mIndices[i+2]]);
+            const auto area = (b-a)%(c-a);
+            if (area[0] == 0.f && area[1] == 0.f && area[2] == 0.f) return false;
+        }
+    }
+    return true;
+}
+
+void LLFloaterModelPreview::setLodestarControlsEnabled(bool enabled)
+{
+    for (S32 lod = 0; lod <= LLModel::LOD_HIGH; ++lod)
+    {
+        for (const auto* prefix : {"lod_source_", "lod_browse_", "lod_mode_", "lod_triangle_limit_", "lod_error_threshold_"})
+            getChildView(std::string(prefix) + lod_name[lod])->setEnabled(enabled);
+    }
+    for (const auto* name : {"gen_normals", "crease_angle", "reset_btn", "lodestar_prepare", "physics_lod_combo", "physics_browse", "import_scale"})
+    {
+        if (auto* control = findChildView(name)) control->setEnabled(enabled);
+    }
+}
+
+void LLFloaterModelPreview::failLodestarPreparation(const std::string& message)
+{
+    mLodestarProcess.reset();
+    mLodestarStage = 0;
+    mLodestarBlocked = true;
+    setLodestarControlsEnabled(true);
+    addStringToLog(message, true);
+    getChild<LLTextBox>("lodestar_preparation_summary")->setText(message);
+    LLSD args;
+    args["MESSAGE"] = message;
+    LLNotificationsUtil::add("GenericAlert", args);
+}
+
+void LLFloaterModelPreview::startLodestarPreparation(const std::string& source)
+{
+    if (mLodestarStage || !mAnalyzeRequests.empty() || mPhysicsFeePending || !mModelPreview || mModelPreview->mLoading)
+    {
+        addStringToLog("Lodestar: Finish the current preparation or import before starting another.", true);
+        return;
+    }
+    if (source.empty() || !LLFile::isfile(source))
+    {
+        failLodestarPreparation("Lodestar: Select the authoritative High source file first.");
+        return;
+    }
+    LLSD config;
+    llifstream settings(gDirUtilp->getExpandedFilename(LL_PATH_APP_SETTINGS, "lodestar-preparation.xml"));
+    if (!settings || LLSDSerialize::fromXML(config, settings) <= 0 ||
+        !LLFile::isfile(config["python"].asString()) || !LLFile::isfile(config["worker"].asString()))
+    {
+        failLodestarPreparation("Lodestar: The local preparation runtime is missing. Install lodestar-preparation.xml with the Python runtime and worker paths.");
+        return;
+    }
+    mLodestarSource = source;
+    mLodestarOutput = gDirUtilp->getTempFilename();
+    mLodestarExpectedFile.clear();
+    mLodestarResult.clear();
+    mLodestarBlocked = true;
+    mLodestarHullsSucceeded = false;
+    mUploadModelUrl.clear();
+    mModelPhysicsFee.clear();
+    mModelPreview->mGenLOD = false;
+    mModelPreview->mLodsQuery.clear();
+    mModelPreview->mLodsWithParsingError.clear();
+    mModelPreview->mLookUpLodFiles = false;
+    LLProcess::Params parameters;
+    parameters.executable = config["python"].asString();
+    parameters.args.add(config["worker"].asString());
+    parameters.args.add(source);
+    parameters.args.add(mLodestarOutput);
+    parameters.args.add("--library");
+    parameters.args.add(gDirUtilp->add(gDirUtilp->getExecutableDir(), "lodestar_c.dll"));
+    parameters.args.add("--import-scale");
+    parameters.args.add(llformat("%.17g", childGetValue("import_scale").asReal()));
+    parameters.autokill = true;
+    parameters.desc = "Lodestar automatic LOD and collision preparation";
+    mLodestarProcess = LLProcess::create(parameters);
+    if (!mLodestarProcess)
+    {
+        failLodestarPreparation("Lodestar: Could not start the local preparation worker.");
+        return;
+    }
+    mLodestarStage = 1;
+    setLodestarControlsEnabled(false);
+    openFloater();
+    const auto preparation_handle = getHandle();
+    doOnIdleRepeating([preparation_handle]()
+    {
+        auto* preparation = dynamic_cast<LLFloaterModelPreview*>(preparation_handle.get());
+        if (!preparation) return true;
+        preparation->pollLodestarPreparation();
+        return preparation->mLodestarStage == 0;
+    });
+    const std::string message = "Lodestar is calculating all visual LODs and correcting collision surfaces from High...";
+    getChild<LLTextBox>("lodestar_preparation_summary")->setText(message);
+    addStringToLog(message, false);
+}
+
+void LLFloaterModelPreview::loadLodestarPreparedLevel(S32 level)
+{
+    static const char* files[] = {"Lodestar_LOD0.dae", "Lodestar_LOD1.dae", "Lodestar_LOD2.dae", "Lodestar.dae"};
+    mLodestarImportLevel = level;
+    mLodestarExpectedFile = gDirUtilp->add(mLodestarOutput,
+        level == LLModel::LOD_PHYSICS ? mLodestarPhysicsFile : files[level]);
+    if (level == LLModel::LOD_PHYSICS) setCtrlLoadFromFile(level);
+    mLodestarInternalLoad = true;
+    mModelPreview->mLoading = true;
+    mModelPreview->loadModel(mLodestarExpectedFile, level, true);
+    mLodestarInternalLoad = false;
+}
+
+void LLFloaterModelPreview::pollLodestarPreparation()
+{
+    if (!mLodestarStage || !mModelPreview) return;
+    if (mLodestarStage == 1)
+    {
+        if (mLodestarProcess && mLodestarProcess->isRunning()) return;
+        const auto process_status = LLProcess::getStatus(mLodestarProcess);
+        mLodestarProcess.reset();
+        llifstream result_file(gDirUtilp->add(mLodestarOutput, "viewer-result.xml"));
+        const bool parsed = result_file && LLSDSerialize::fromXML(mLodestarResult, result_file) > 0;
+        if (process_status.mState != LLProcess::EXITED || process_status.mData != 0 || !parsed ||
+            mLodestarResult["status"].asString() != "prepared")
+        {
+            failLodestarPreparation(mLodestarResult["message"].asString().empty() ?
+                "Lodestar preparation failed. Inspect preparation.log in " + mLodestarOutput :
+                mLodestarResult["message"].asString());
+            return;
+        }
+        if (mLodestarResult["size_container_required"].asBoolean())
+        {
+            failLodestarPreparation(llformat("Lodestar proposed size containers for %d tiny models. Review size-proposals.json in ",
+                mLodestarResult["size_container_count"].asInteger()) + mLodestarOutput);
+            return;
+        }
+        mLodestarPhysicsFile = mLodestarResult["physics_file"].asString();
+        if (mLodestarPhysicsFile != "Lodestar_PHYS.dae" && mLodestarPhysicsFile != "Lodestar_unresolved_PHYS.dae")
+        {
+            failLodestarPreparation("Lodestar returned an invalid physics companion name.");
+            return;
+        }
+        for (S32 lod = 0; lod <= LLModel::LOD_HIGH; ++lod)
+        {
+            mLODMode[lod] = LLModelPreview::LOD_FROM_FILE;
+            getChild<LLComboBox>("lod_source_" + lod_name[lod])->setCurrentByIndex(LLModelPreview::LOD_FROM_FILE);
+        }
+        addStringToLog(llformat("Lodestar calculated High/Medium/Low/Lowest: %d / %d / %d / %d triangles.",
+            mLodestarResult["high_triangles"].asInteger(), mLodestarResult["medium_triangles"].asInteger(),
+            mLodestarResult["low_triangles"].asInteger(), mLodestarResult["lowest_triangles"].asInteger()), false);
+        addStringToLog(llformat("Lodestar collision basis: %s. Surface deviation bound against High: %.6g m before upload packing.",
+            mLodestarResult["physics_source_level"].asString().c_str(),
+            mLodestarResult["physics_surface_bound"].asReal()), false);
+        if (mLodestarResult["physical_container_count"].asInteger() > 0)
+            addStringToLog(llformat("Lodestar applied %d physical container boxes. Visual dimensions retained at import scale %.6g.",
+                mLodestarResult["physical_container_count"].asInteger(),
+                mLodestarResult["physical_container_import_scale"].asReal()), false);
+        mLodestarStage = 2;
+        loadLodestarPreparedLevel(LLModel::LOD_HIGH);
+        return;
+    }
+    if (mModelPreview->mLoading || mModelPreview->mModelLoader) return;
+    if (mLodestarStage == 2 || mLodestarStage == 4 || mLodestarStage == 5)
+    {
+        if (mModelPreview->mLODFile[mLodestarImportLevel] != mLodestarExpectedFile ||
+            mModelPreview->mModel[mLodestarImportLevel].empty() || !mModelPreview->mLodsWithParsingError.empty())
+        {
+            failLodestarPreparation("Lodestar: Native viewer import failed. The generated package remains blocked.");
+            return;
+        }
+        const S32 expected_containers = mLodestarResult["physical_container_count"].asInteger();
+        if (expected_containers > 0)
+        {
+            if (fabs(mLodestarResult["physical_container_import_scale"].asReal()-childGetValue("import_scale").asReal()) > 1e-10)
+            {
+                failLodestarPreparation("Lodestar: Import scale changed during preparation. Prepare again to recalculate the physical containers.");
+                return;
+            }
+            const auto& models = mModelPreview->mModel[mLodestarImportLevel];
+            const auto imported_containers = std::count_if(models.begin(), models.end(), [](const auto& model) {
+                return model && !model->mSubmodelID && model->mLodestarPhysicalContainer;
+            });
+            if (imported_containers != expected_containers)
+            {
+                failLodestarPreparation("Lodestar: Native import did not retain every physical container frame. Upload blocked to preserve authored scale.");
+                return;
+            }
+            if (mLodestarImportLevel != LLModel::LOD_PHYSICS)
+                for (const auto& model : models)
+                    if (model && model->mLodestarPhysicalContainer && !lodestarContainerSurfaceValid(*model.get()))
+                    {
+                        failLodestarPreparation("Lodestar: A physical frame produces invalid packed visual geometry. Upload blocked; source surface retained.");
+                        return;
+                    }
+        }
+        if (mLodestarStage == 2 && mLodestarImportLevel > LLModel::LOD_IMPOSTOR)
+        {
+            loadLodestarPreparedLevel(mLodestarImportLevel - 1);
+            return;
+        }
+        for (S32 lod = 0; lod < LLModel::LOD_HIGH; ++lod)
+        {
+            mLODMode[lod] = LLModelPreview::LODESTAR_AUTO;
+            getChild<LLComboBox>("lod_source_" + lod_name[lod])->setCurrentByIndex(LLModelPreview::LODESTAR_AUTO);
+            mModelPreview->updateLodControls(lod);
+        }
+        if (mLodestarStage == 2)
+        {
+            mModelPreview->setPreviewLOD(LLModel::LOD_HIGH);
+            mLodestarStage = 5;
+            loadLodestarPreparedLevel(LLModel::LOD_PHYSICS);
+            return;
+        }
+        if (mLodestarStage == 5)
+        {
+            mLodestarStage = 3;
+            mDecompParams["Num Hulls"] = 256;
+            getChild<LLSpinCtrl>("Num Hulls")->setValue(LLSD(256));
+            startPhysicsAnalysis();
+            return;
+        }
+        mModelPreview->rebuildUploadData();
+        mModelPreview->updateStatusMessages();
+        mLodestarStage = 0;
+        setLodestarControlsEnabled(true);
+        mLodestarBlocked = !mLodestarResult["triangle_ready"].asBoolean() ||
+            !mModelPreview->mModelNoErrors || mModelPreview->mHasDegenerate;
+        std::string message = "Lodestar LODs calculated. Native triangle physics validation passed; hull conversion was unavailable.";
+        if (mLodestarBlocked)
+        {
+            const auto unresolved = mLodestarResult["unresolved_triangles"].asInteger();
+            const auto* physics_status = getChild<LLTextBox>("physics_status_message_text");
+            if (mModelPreview->mHasDegenerate)
+            {
+                message = "Lodestar: Native physics import found degenerate triangles. See Physics/Log.";
+            }
+            else if (unresolved > 0)
+            {
+                message = llformat("Lodestar LODs calculated. Physics blocked. Remaining triangle failures: %d. See Physics/Log.", unresolved);
+            }
+            else if (mLodestarResult["triangle_ready"].asBoolean() && physics_status->getVisible() &&
+                     physics_status->getText() == getString("phys_status_too_thin"))
+            {
+                message = "Lodestar triangles passed. Instances below 0.5 m require supported hulls.";
+            }
+            else
+            {
+                message = "Lodestar preparation is blocked by native model validation. See Physics/Log.";
+            }
+            if (physics_status->getVisible() && !physics_status->getText().empty())
+            {
+                addStringToLog("Lodestar native physics blocker: " + physics_status->getText(), true);
+            }
+        }
+        getChild<LLTextBox>("lodestar_preparation_summary")->setText(message);
+        addStringToLog(message, mLodestarBlocked);
+        return;
+    }
+    if (mLodestarStage == 3 && mAnalyzeRequests.empty())
+    {
+        if (mLodestarHullsSucceeded)
+        {
+            mModelPreview->rebuildUploadData();
+            mModelPreview->updateStatusMessages();
+            mLodestarStage = 0;
+            setLodestarControlsEnabled(true);
+            mLodestarBlocked = !mModelPreview->mModelNoErrors;
+            const std::string message = mLodestarBlocked ? "Lodestar: Native upload validation is blocked." :
+                "Lodestar collision prepared. Native viewer checks passed.";
+            getChild<LLTextBox>("lodestar_preparation_summary")->setText(message);
+            addStringToLog(message, mLodestarBlocked);
+        }
+        else
+        {
+            mLodestarStage = 4;
+            loadLodestarPreparedLevel(LLModel::LOD_PHYSICS);
+        }
+    }
+}
